{
  "manifest_version": 3,
  "name": "Khana Reader | خوانا",
  "version": "1.1.0",
  "description": "فونت، تم رنگی راحت برای چشم، تشخیص خودکار RTL/LTR و ظاهر بهتر کد برای مطالعهٔ راحت‌تر در وب.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "خوانا",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/highlight.min.js", "shared.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/Vazirmatn.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
